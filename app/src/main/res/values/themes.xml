<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The window behind Compose: the brand color while the app starts, with
         the mark on it from Android 12. -->
    <style name="Theme.TingId" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_icon</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="brand">#4F46E5</color>
</resources>
